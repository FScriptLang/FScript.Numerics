let data = NDArray.ofRows [[(0.0 - 2.0);(0.0 - 2.0)];[(0.0 - 1.0);(0.0 - 1.0)];[9.0;9.0];[10.0;10.0]]
let model = KMeans.fit data 2 42 300 0.000001
let predictions = KMeans.predict model data
(model.Converged, model.ClusterCount, model.Inertia, NDArray.equals predictions (KMeans.predict (KMeans.fit data 2 42 300 0.000001) data))
