<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>FScript extension for float64 numerical arrays and explicit element mutation.</Description>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FScript.Numerics/FScript.Numerics.csproj" />
    <PackageReference Include="MagnusOpera.FScript.Extensibility" />
  </ItemGroup>
  <!-- Pin the companion package to this release, rather than NuGet's default minimum range. -->
  <Target Name="PinCoreDependency" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)">
        <ProjectVersion>[$(PackageVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>
</Project>
